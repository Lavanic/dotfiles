# Default-deny: nothing at the top level is tracked unless listed here.
/*
!/.gitignore
!/.githooks/
!/.github/
!/README.md
!/install.sh
!/otop.md
!/fish/
!/starship/
!/wezterm/
!/git/
!/zed/
!/btop/
!/claude/
!/neofetch/
!/powerdevil/
!/system/
!/bin/
!/packages.txt
!/packages-aur.txt

# machine-local files
local.fish

# Runtime and machine-local files, anywhere in the tree
fish_variables
settings.local.json
.credentials.json
history.jsonl
*.save
*~
