# Default-deny: nothing at the top level is tracked unless listed here.
/*
!/.gitignore
!/.githooks/
!/README.md
!/install.sh
!/otop.md
!/fish/
!/starship/
!/wezterm/
!/git/
!/zed/
!/btop/
!/claude/

# Runtime and machine-local files, anywhere in the tree
fish_variables
settings.local.json
.credentials.json
history.jsonl
*.save
*~
