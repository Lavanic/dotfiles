#!/usr/bin/env -S uv run --quiet --script
# /// script
# requires-python = ">=3.10"
# dependencies = ["claude-agent-sdk>=0.2.140"]
# ///
"""Hand a task to Claude Fable 5.2 through the Agent SDK, billed to an Anthropic Console API key
instead of the Max plan.

usage: fable [--edit] [--bash] [--budget USD] [--model ID] [--resume SESSION] TASK
       echo TASK | fable

Read-only by default (Read, Glob, Grep). --edit also allows Edit and Write, --bash allows Bash.
The final answer goes to stdout. Tool calls and the cost line go to stderr.
The key comes from $FABLE_API_KEY or ~/.local/share/fable/api-key, and only this process sees it.
Every run is appended to ~/.local/share/fable/spend.jsonl.
"""

import argparse
import asyncio
import json
import os
import sys
import time
from pathlib import Path

from claude_agent_sdk import (
    AssistantMessage,
    ClaudeAgentOptions,
    CLINotFoundError,
    ProcessError,
    ResultError,
    ResultMessage,
    TextBlock,
    ToolUseBlock,
    query,
)

DATA = Path.home() / ".local/share/fable"
KEY_FILE = DATA / "api-key"
LOG = DATA / "spend.jsonl"


def load_key() -> str:
    key = os.environ.get("FABLE_API_KEY") or (KEY_FILE.read_text().strip() if KEY_FILE.exists() else "")
    if not key.startswith("sk-ant-"):
        sys.exit(f"fable: no API key. Save it to {KEY_FILE} with chmod 600, or set FABLE_API_KEY.")
    return key


def isolate_env() -> None:
    # Usually started from inside a Claude Code session. Its variables would tie the child to that
    # session, and any credential among them could outrank the API key and bill the Max plan.
    for name in list(os.environ):
        if name.startswith(("CLAUDE", "ANTHROPIC")):
            del os.environ[name]


def describe(block: ToolUseBlock) -> str:
    args = block.input
    target = next((args[k] for k in ("file_path", "path", "pattern", "command") if args.get(k)), "")
    return f"  {block.name} {str(target)[:120]}"


def spent_so_far() -> float:
    if not LOG.exists():
        return 0.0
    return sum(json.loads(line).get("cost_usd") or 0 for line in LOG.read_text().splitlines() if line.strip())


def log_run(task: str, model: str, cost: float | None, turns: int | None, session: str | None, outcome: str) -> None:
    DATA.mkdir(parents=True, exist_ok=True)
    entry = {
        "at": time.strftime("%Y-%m-%dT%H:%M:%S"),
        "cwd": os.getcwd(),
        "model": model,
        "cost_usd": cost,
        "turns": turns,
        "session": session,
        "outcome": outcome,
        "task": task[:120],
    }
    with LOG.open("a") as f:
        f.write(json.dumps(entry) + "\n")


async def run(args: argparse.Namespace, task: str) -> int:
    allowed = ["Read", "Glob", "Grep"]
    blocked = []
    for flag, tools in ((args.edit, ["Edit", "Write", "NotebookEdit"]), (args.bash, ["Bash"])):
        (allowed if flag else blocked).extend(tools)

    options = ClaudeAgentOptions(
        model=args.model,
        cwd=os.getcwd(),
        system_prompt={"type": "preset", "preset": "claude_code"},
        # project only: user settings carry hooks (the dotfiles sync hook) that must not fire in here
        setting_sources=["project"],
        allowed_tools=allowed,
        disallowed_tools=blocked,
        permission_mode="dontAsk",
        max_budget_usd=args.budget,
        max_turns=args.max_turns,
        resume=args.resume,
        env={"ANTHROPIC_API_KEY": load_key()},
    )

    code = 1
    try:
        async for message in query(prompt=task, options=options):
            if isinstance(message, AssistantMessage):
                for block in message.content:
                    if isinstance(block, ToolUseBlock):
                        print(describe(block), file=sys.stderr, flush=True)
            elif isinstance(message, ResultMessage):
                print(message.result or "")
                log_run(task, args.model, message.total_cost_usd, message.num_turns, message.session_id, message.subtype)
                cost = message.total_cost_usd or 0
                print(
                    f"fable: {message.subtype}, {message.num_turns} turns, {message.duration_ms / 1000:.0f}s, "
                    f"${cost:.4f} this run, ${spent_so_far():.2f} logged in total, session {message.session_id}",
                    file=sys.stderr,
                )
                # no return here: leaving the loop early makes the SDK's generator fail on close
                code = 1 if message.is_error else 0
    except ResultError as e:
        cost = e.data.get("total_cost_usd")
        log_run(task, args.model, cost, e.data.get("num_turns"), e.session_id, e.terminal_reason or e.subtype or "error")
        if e.data.get("stop_reason") == "refusal":
            print(f"fable: the model declined: {e}", file=sys.stderr)
        else:
            print(f"fable: run ended with an error ({e.terminal_reason or e.subtype}): {e}", file=sys.stderr)
        if cost:
            print(f"fable: ${cost:.4f} spent on this run", file=sys.stderr)
        return 1
    except CLINotFoundError:
        print("fable: the SDK could not find its bundled Claude Code; try `uv cache clean claude-agent-sdk`", file=sys.stderr)
        return 1
    except ProcessError as e:
        print(f"fable: Claude Code exited with code {e.exit_code}", file=sys.stderr)
        return 1
    return code


def main() -> None:
    parser = argparse.ArgumentParser(prog="fable", description=__doc__.split("\n\n")[0])
    parser.add_argument("task", nargs="*", help="what to do; read from stdin when omitted")
    parser.add_argument("--edit", action="store_true", help="allow Edit and Write")
    parser.add_argument("--bash", action="store_true", help="allow Bash")
    parser.add_argument("--budget", type=float, default=3.0, help="stop when this run's cost estimate reaches USD (default 3)")
    parser.add_argument("--max-turns", type=int, default=60)
    parser.add_argument("--model", default="claude-fable-5-2")
    parser.add_argument("--resume", metavar="SESSION", help="continue an earlier fable session by id")
    parser.add_argument("--spent", action="store_true", help="print the logged total and exit")
    args = parser.parse_args()

    if args.spent:
        print(f"${spent_so_far():.2f} logged in {LOG}")
        return
    task = " ".join(args.task) if args.task else sys.stdin.read()
    if not task.strip():
        parser.error("no task given")
    isolate_env()
    sys.exit(asyncio.run(run(args, task)))


if __name__ == "__main__":
    main()
