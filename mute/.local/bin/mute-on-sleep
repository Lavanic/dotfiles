#!/bin/bash
# Mutes every output at login and around suspend, so the laptop never wakes up loud.

mute_all() {
    pactl list short sinks | cut -f2 | while read -r sink; do
        pactl set-sink-mute "$sink" 1
    done
}

# Audio devices can still be appearing when autostart fires
for _ in {1..10}; do
    [ -n "$(pactl list short sinks)" ] && break
    sleep 1
done
mute_all

# PrepareForSleep fires with true before suspend and false after resume. Muting on
# both covers the case where suspend wins the race against the first mute.
gdbus monitor --system --dest org.freedesktop.login1 --object-path /org/freedesktop/login1 |
    while read -r line; do
        [[ $line == *PrepareForSleep* ]] && mute_all
    done
