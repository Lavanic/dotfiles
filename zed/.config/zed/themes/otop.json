{
  "$schema": "https://zed.dev/schema/themes/v0.2.0.json",
  "name": "Otop",
  "author": "Lavanic",
  "themes": [
    {
      "name": "Otop",
      "appearance": "dark",
      "style": {
        "background.appearance": "blurred",
        "background": "#000000eb",
        "surface.background": "#000000eb",
        "elevated_surface.background": "#111111",
        "panel.background": "#000000eb",
        "toolbar.background": "#000000eb",
        "tab_bar.background": "#000000eb",
        "tab.active_background": "#1a1a1a",
        "tab.inactive_background": "#000000eb",
        "title_bar.background": "#000000eb",
        "status_bar.background": "#000000eb",
        "editor.background": "#000000eb",
        "editor.gutter.background": "#000000eb",
        "editor.foreground": "#ffffff",
        "editor.line_number": "#555555",
        "editor.active_line_number": "#f0c050",
        "editor.active_line.background": "#11111180",
        "element.background": "#111111",
        "element.hover": "#1a1a1a",
        "element.selected": "#2a2a2a",
        "border": "#5f8787",
        "border.variant": "#303030",
        "text": "#ffffff",
        "text.muted": "#bcbcbc",
        "text.placeholder": "#555555",
        "text.accent": "#4897d4",
        "icon.muted": "#bcbcbc",
        "scrollbar.thumb.background": "#55555580",
        "scrollbar.track.background": "#00000000",
        "created": "#50f095",
        "modified": "#f0c050",
        "deleted": "#f05050",
        "conflict": "#ff40b6",
        "ignored": "#555555",
        "error": "#f05050",
        "warning": "#f0c050",
        "info": "#4897d4",
        "success": "#50f095",
        "hint": "#5f8787",
        "terminal.background": "#000000eb",
        "terminal.foreground": "#ffffff",
        "terminal.ansi.black": "#000000",
        "terminal.ansi.red": "#f05050",
        "terminal.ansi.green": "#50f095",
        "terminal.ansi.yellow": "#f0c050",
        "terminal.ansi.blue": "#4897d4",
        "terminal.ansi.magenta": "#ff40b6",
        "terminal.ansi.cyan": "#5f8787",
        "terminal.ansi.white": "#bcbcbc",
        "terminal.ansi.bright_black": "#555555",
        "terminal.ansi.bright_red": "#ff5555",
        "terminal.ansi.bright_green": "#90ff90",
        "terminal.ansi.bright_yellow": "#ffe080",
        "terminal.ansi.bright_blue": "#8080ff",
        "terminal.ansi.bright_magenta": "#ff80ff",
        "terminal.ansi.bright_cyan": "#87afaf",
        "terminal.ansi.bright_white": "#ffffff",
        "players": [
          {
            "cursor": "#ffff55",
            "background": "#ffff55",
            "selection": "#55555566"
          }
        ],
        "syntax": {
          "comment": { "color": "#5f8787", "font_style": "italic" },
          "comment.doc": { "color": "#87afaf", "font_style": "italic" },
          "string": { "color": "#50f095" },
          "string.special": { "color": "#90ff90" },
          "string.escape": { "color": "#ffe080" },
          "keyword": { "color": "#ff40b6" },
          "operator": { "color": "#bcbcbc" },
          "number": { "color": "#f0c050" },
          "boolean": { "color": "#f0c050" },
          "constant": { "color": "#f0c050" },
          "function": { "color": "#4897d4" },
          "type": { "color": "#87afaf" },
          "constructor": { "color": "#4897d4" },
          "property": { "color": "#ffffff" },
          "variable": { "color": "#ffffff" },
          "variable.special": { "color": "#ff5555" },
          "attribute": { "color": "#f0c050" },
          "tag": { "color": "#f05050" },
          "punctuation": { "color": "#bcbcbc" },
          "punctuation.special": { "color": "#ff5555" },
          "link_uri": { "color": "#4897d4", "font_style": "italic" },
          "emphasis": { "font_style": "italic" },
          "emphasis.strong": { "font_weight": 700 },
          "title": { "color": "#f0c050", "font_weight": 700 }
        }
      }
    }
  ]
}
